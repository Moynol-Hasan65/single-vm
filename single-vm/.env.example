# Host
HOST_IP=192.168.1.100


# Docker images
USER_IMAGE=polygontechxyz/cyberwise-user:cyberwise-production-1.0.12
LMS_IMAGE=polygontechxyz/cyberwise-lms:cyberwise-production-1.0.12
WEB_IMAGE=polygontechxyz/cyberwise-web:cyberwise-production-1.0.18
PHISH_IMAGE=polygontechxyz/cyberwise-phish:cyberwise-production-1.0.12

# Docker Hub (optional, only needed for private images)
DOCKER_HUB_USER=
DOCKER_HUB_PASS=


# MySQL
MYSQL_ROOT_PASSWORD=replace_with_a_password
MYSQL_DATABASE=cyberwise_user
MYSQL_USER=cyberwise
MYSQL_PASSWORD=replace_with_a_password


# Spring datasource — points at the same DB/user above, same network
# Quoted: unquoted "&"/"?" in a JDBC URL gets misparsed if this file is ever
# sourced by bash (job-control "&") — quoting keeps it safe either way.
DATABASE_HOST="jdbc:mysql://cyberwise-mysql:3306/cyberwise_user?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC"
DATABASE_USER=cyberwise
DATABASE_PASSWORD=replace_with_a_password
USER_DATASOURCE_URL="jdbc:mysql://cyberwise-mysql:3306/cyberwise_user?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC"
DATABASE_HOST_LMS="jdbc:mysql://cyberwise-mysql:3306/cyberwise_lms?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC"
LMS_DATASOURCE_URL="jdbc:mysql://cyberwise-mysql:3306/cyberwise_lms?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC"


# MinIO — internal endpoint only, container-to-container, no editing needed
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=replace_with_a_password
MINIO_CONSOLE_PORT=9001
MINIO_URL=http://cyberwise-minio:9000
MINIO_PUBLIC_URL=http://cyberwise-minio:9000
MINIO_ACCESS_KEY=your_access_key
MINIO_SECRET_KEY=your_secret_key
MINIO_BUCKET=cyberwise


# Secrets (generate each with: openssl rand -hex 32)
JWT_SECRET=replace_with_64_char_hex
APPLICATION_SECRET=replace_with_64_char_hex
LICENSE_SECRET=replace_with_license_secret

JWT_ACCESS_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=86400000
INVITATION_EXPIRATION=86400000
RESET_PASSWORD_EXPIRATION=3600000


# Super admin
SUPER_ADMIN_EMAIL=sadmin@polygontech.com
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_PASSWORD=replace_with_a_password


# SMTP
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER_NAME=your_email@gmail.com
MAIL_PASSWORD=your_smtp_password
MAIL_REGISTRATION_URL="http://192.168.1.100:3000/register?x="
MAIL_FORGET_PASSWORD_URL="http://192.168.1.100:3000/auth/confirm-password?x="
MAIL_LOGIN_URL=http://192.168.1.100:3000/login


# gRPC (user -> lms) — internal, container-to-container, no editing needed
GRPC_LMS_END_POINT=static://cyberwise-lms:9090


# phish
GO_PHISH_URL=http://cyberwise-phish:3333/api
GO_PHISH_TOKEN=replace_with_64_char_hex
GOPHISH_ADMIN_PASSWORD=replace_with_a_password
GOPHISH_WEBHOOK_SECRET=replace_with_64_char_hex


# App URLs (browser-facing, built from HOST_IP)
# NEXT_PUBLIC_LANDING_PAGE_URL=https://landing.<client-domain>:3000
NEXT_PUBLIC_LANDING_PAGE_URL=http://192.168.1.100:3000/landing
LOCAL_URL=http://192.168.1.100:10081/api/v1
API_URL=http://192.168.1.100:10081/api/v1
API_PUBLIC_URL=


# Logging
SQL_LOG_LEVEL=OFF
LOG_LEVEL=INFO
